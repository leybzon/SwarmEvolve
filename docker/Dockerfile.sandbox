# SwarmEvolve sandbox image (M8).
#
# Purpose: isolated compile+run environment for LLM-authored AI code.
# Stage 1 installs a C++17 toolchain + Python 3 so the loop-guard injector
# runs inside the container. Stage 2 copies only what the runtime needs
# (engine headers, baselines, injector, engine source, helper scripts) into
# a slim image with a non-root default user.
#
# CUDA / nvc++ are deliberately out of scope here; the GPU path lands in
# milestone M11 on a CUDA-devel base. M8 only needs to prove the isolation
# boundary, not GPU acceleration.
#
# Build:
#   docker build -f docker/Dockerfile.sandbox -t swarmevolve-sandbox:latest .
#
# Run (flags must match scripts/sandbox.py):
#   docker run --rm --network=none --cap-drop=ALL \
#       --security-opt no-new-privileges --read-only \
#       --tmpfs /tmp:size=16m --memory=512m --pids-limit=64 --cpus=2 \
#       --user 65534:65534 \
#       -v <src>:/work/src:ro -v <out>:/work/out \
#       swarmevolve-sandbox:latest --seed 42 --max-ticks 1000

# ---------------------------------------------------------------------------
# Stage 1 — builder: full toolchain + Python, used to install deps into /opt.
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        g++ \
        clang \
        make \
        python3 \
        python3-venv \
        python3-pip \
 && rm -rf /var/lib/apt/lists/*

# Baked-in Python venv (offline at runtime; nothing needs pip).
# Kept minimal: the sandbox only needs stdlib for the injector + entrypoint.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# ---------------------------------------------------------------------------
# Stage 2 — runtime: slim image, non-root user, read-only bind-mount layout.
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:/usr/bin:/bin"

# Runtime toolchain: g++ + python3 only. No curl, no networking tools.
# 'nobody:nogroup' (65534:65534) already exists on Ubuntu.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        g++ \
        libstdc++-11-dev \
        python3 \
        python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /work/src /work/out /opt/swarmevolve \
 && chown -R 65534:65534 /work/out

COPY --from=builder /opt/venv /opt/venv

# Copy only what the entrypoint needs. The read-only bind at /work/src adds
# the candidate AIs; the opponent+engine+injector are baked in to remove
# any way for a malicious mount to swap them out.
COPY src/engine.cpp           /opt/swarmevolve/engine.cpp
COPY src/engine.h             /opt/swarmevolve/engine.h
COPY src/types.h              /opt/swarmevolve/types.h
COPY src/ai_abi.h             /opt/swarmevolve/ai_abi.h
COPY src/baselines            /opt/swarmevolve/baselines
COPY scripts/inject_guards.py /opt/swarmevolve/inject_guards.py
COPY docker/entrypoint.sh     /opt/swarmevolve/entrypoint.sh
RUN chmod 0555 /opt/swarmevolve/entrypoint.sh

USER 65534:65534
WORKDIR /work

ENTRYPOINT ["/opt/swarmevolve/entrypoint.sh"]
CMD []
